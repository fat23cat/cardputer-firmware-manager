diff --git a/src/FSCommon.h b/src/FSCommon.h
index c85c079..4a4260f 100644
--- a/src/FSCommon.h
+++ b/src/FSCommon.h
@@ -35,7 +35,8 @@ using namespace STM32_LittleFS_Namespace;
 // ESP32 version
 #include "LittleFS.h"
 #define FSCom LittleFS
-#define FSBegin() FSCom.begin(true) // format on failure
