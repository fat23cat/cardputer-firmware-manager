diff --git a/src/mesh/NodeDB.cpp b/src/mesh/NodeDB.cpp
index 8b47c10..441eacd 100644
--- a/src/mesh/NodeDB.cpp
+++ b/src/mesh/NodeDB.cpp
@@ -539,8 +539,17 @@ bool NodeDB::factoryReset(bool eraseBleBonds)
     if (eraseBleBonds) {
         LOG_INFO("Erase BLE bonds");
 #ifdef ARCH_ESP32
-        // This will erase what's in NVS including ssl keys, persistent variables and ble pairing
-        nvs_flash_erase();
+        // CRUB shared extra: the default NVS also holds other applications' settings.
+        // Erase only Meshtastic's namespaces: persistent variables, ssl keys and ble pairing.
+        static const char *const meshNamespaces[] = {"meshtastic", "MeshtasticOTA", "MeshtasticHTTPS", "mesh_bond"};
+        for (const char *name : meshNamespaces) {
+            nvs_handle_t handle;
+            if (nvs_open(name, NVS_READWRITE, &handle) == ESP_OK) {
+                nvs_erase_all(handle);
+                nvs_commit(handle);
+                nvs_close(handle);
+            }
+        }
 #endif
 #ifdef ARCH_NRF52
         LOG_INFO("Clear bluetooth bonds!");
